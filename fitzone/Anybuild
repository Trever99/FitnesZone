# Full-stack Node.js (Express) deploy with Vite frontend.
# Forces the `node` provider (not node-static) so the Express API runs.
load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {"start": "node --experimental-sqlite server/index.js"},
    node_framework = "vite",
    node_package_manager = "npm",
    node_server = "node",
    node_version = "24",
    node_install_requires_all_files = True,
)

build = node_build(config)

node_serve(config, build, name = "fitzone")
